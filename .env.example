# ============================================================
# Root5 DAO — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# ============================================================

# ----- Vercel / Server-side (API routes only) -----
# From: Supabase → Project Settings → API → URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# From: Supabase → Project Settings → API → service_role secret
# KEEP THIS SECRET — only set in Vercel environment variables, never in client code
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----- Frontend (Vite — exposed to browser, must be prefixed VITE_) -----
# Same Supabase URL as above (safe to expose, used for public reads)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# From: Supabase → Project Settings → API → anon public key
# This is the anon key — RLS limits it to public SELECT only
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----- Optional: Custom RPC endpoints (server-side, for token balance checks) -----
# Leave blank to use the free public defaults. Set these for better reliability.
# Default: https://eth.llamarpc.com
EVM_RPC_ETHEREUM=
# Default: https://bsc-dataseed.binance.org
EVM_RPC_BSC=
# Default: https://arb1.arbitrum.io/rpc
EVM_RPC_ARBITRUM=
# Default: https://mainnet.base.org
EVM_RPC_BASE=
# Default: https://api.mainnet-beta.solana.com
SOLANA_RPC=

# ----- Squads Treasury (server-side, for the Treasury page) -----
# The address from your Squads URL: app.squads.so/squads/{address}/treasury
# Used by /api/treasury to read live SOL + SPL token balances.
# Add this in Vercel Dashboard → Project Settings → Environment Variables.
SQUADS_VAULT_ADDRESS=7qcxTk4kGdiGUxD7T59tQygJToe4rC4F7GyTTyYYyPMK

# ----- Optional: Google Gemini AI -----
# Used by services/geminiService.ts for AI-powered proposal summaries
GEMINI_API_KEY=
